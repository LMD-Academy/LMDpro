# LMDpro Environment Variables - PRODUCTION
# ⚠️ SECURITY WARNING: This file should NEVER be committed to version control
# Set these values in Vercel Dashboard: Settings > Environment Variables
# 
# SETUP INSTRUCTIONS:
# 1. Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# 2. Add each variable below with actual production values
# 3. Never commit this file to the repository
# 4. Use different values for staging and production

# ==========================================
# REQUIRED: GOOGLE AI & OAUTH
# ==========================================

# Google AI API Key (required for AI features)
GOOGLE_API_KEY=your_production_google_ai_api_key_here

# Gemini API Key
GEMINI_API_KEY=your_production_google_ai_api_key_here

# Google OAuth 2.0 (production app credentials)
GOOGLE_CLIENT_ID=your_production_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_google_client_secret_here

# ==========================================
# REQUIRED: AUTHENTICATION
# ==========================================

# Production NextAuth URL
NEXTAUTH_URL=https://www.lmdpro.com

# Production NextAuth Secret (generate new for production!)
NEXTAUTH_SECRET=your_production_nextauth_secret_key_min_32_characters

# ==========================================
# REQUIRED: APPLICATION
# ==========================================

# Public site URL
NEXT_PUBLIC_SITE_URL=https://www.lmdpro.com

# Node environment
NODE_ENV=production

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1

# ==========================================
# OPTIONAL: DATABASE
# ==========================================

# PostgreSQL production connection string
DATABASE_URL=postgresql://production_user:production_password@prod-db-host:5432/lmdpro_prod

# ==========================================
# OPTIONAL: ANALYTICS & MONITORING
# ==========================================

# Google Analytics
GOOGLE_ANALYTICS_ID=your_production_analytics_id

# Sentry error tracking (if using)
SENTRY_DSN=your_sentry_dsn_here

# ==========================================
# OPTIONAL: EMAIL
# ==========================================

# Production SMTP for notifications
SMTP_HOST=production_smtp_host
SMTP_PORT=587
SMTP_USER=production_smtp_user
SMTP_PASS=production_smtp_password

# ==========================================
# SECURITY
# ==========================================

# Production allowed origins
ALLOWED_ORIGINS=https://www.lmdpro.com,https://lmdpro.com

# ==========================================
# HOW TO SET UP IN VERCEL
# ==========================================
#
# 1. Sign in to Vercel Dashboard
# 2. Select your LMDpro project
# 3. Go to Settings > Environment Variables
# 4. For each variable:
#    - Add variable name (left side)
#    - Add variable value (right side)
#    - Select which environments: Production, Preview, Development
# 5. Click "Save"
# 6. Redeploy your project for changes to take effect
#
# PRODUCTION SETUP CHECKLIST:
# [ ] GOOGLE_API_KEY - Set to production key
# [ ] GEMINI_API_KEY - Set to production key
# [ ] GOOGLE_CLIENT_ID - Set to production OAuth app
# [ ] GOOGLE_CLIENT_SECRET - Set to production OAuth secret
# [ ] NEXTAUTH_URL - Set to https://www.lmdpro.com
# [ ] NEXTAUTH_SECRET - Generate new secure random value
# [ ] NEXT_PUBLIC_SITE_URL - Set to https://www.lmdpro.com
# [ ] NODE_ENV - Set to production
# [ ] DATABASE_URL - Set to production database URL
# [ ] ALLOWED_ORIGINS - Set to production domain
